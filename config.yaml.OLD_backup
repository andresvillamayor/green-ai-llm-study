experiment_name: green_ai_llm_quality_energy
output_dir: results

hardware_profile: mac_m4
execution_device: gpu

repetitions: 15
randomize_order: true
seed: 42
backup_every_n_conversations: 50
rerun_failed: true

runtime_control:
  prevent_sleep: true
  use_caffeinate_on_macos: true
  cooldown_seconds_between_runs: 10
  cooldown_seconds_between_model_configs: 60
  warmup_runs_per_configuration: 1
  discard_warmup_runs: true
  pause_before_start_seconds: 30
  pause_after_model_load_seconds: 20
  pause_after_experiment_seconds: 10

energy_calibration:
  enabled: true
  baseline_idle_seconds: 60
  baseline_repetitions: 3
  subtract_idle_baseline: true
  save_baseline_runs: true

prompt_dataset:
  name: mt_bench_literal_subset
  language: english
  source: official_fastchat_mt_bench
  use_multi_turn: true
  questions_per_category: 5
  turns_per_question: 2
  official_question_file: data/mt_bench/official/question.jsonl
  official_judge_prompt_file: data/mt_bench/official/judge_prompts.jsonl
  subset_output_jsonl: data/mt_bench/subset/mt_bench_literal_subset_5_per_category.jsonl
  subset_output_yaml: data/mt_bench/subset/mt_bench_literal_subset_5_per_category.yaml
  subset_manifest_csv: data/mt_bench/subset/mt_bench_subset_manifest.csv
  download_official_mt_bench: false
  force_download: false
  category_mapping:
    writing: writing
    roleplay: roleplay
    extraction: extraction
    reasoning: reasoning
    math: math
    coding: coding
    stem: stem
    humanities: humanities_social_sciences
  selected_categories:
    - writing
    - roleplay
    - extraction
    - reasoning
    - math
    - coding
    - stem
    - humanities
  selection_strategy: first_n_per_category
  random_seed: 42

hardware_profiles:
  mac_m4:
    os_family: macos
    machine: Apple Mac Mini
    chip: Apple M4
    cpu_description: Apple M4 10-core CPU
    gpu_description: Apple M4 10-core GPU
    integrated_gpu_description: null
    ram_gb: 16
    dedicated_vram_gb: null
    gpu_backend: Metal
    llama_cpp_backend: metal
    cpu_n_gpu_layers: 0
    gpu_n_gpu_layers: -1
    n_threads: 8
    n_batch: 512
    notes: Apple Silicon with Metal acceleration
  windows_nvidia:
    os_family: windows
    machine: Windows laptop
    chip: null
    cpu_description: 13th Gen Intel Core i7-13700H
    gpu_description: NVIDIA GeForce RTX 4060 Laptop GPU
    integrated_gpu_description: Intel Iris Xe Graphics
    ram_gb: 32
    dedicated_vram_gb: 8
    gpu_backend: CUDA
    llama_cpp_backend: cuda
    cpu_n_gpu_layers: 0
    gpu_n_gpu_layers: -1
    n_threads: 12
    n_batch: 512
    notes: Windows system with NVIDIA RTX 4060 Laptop GPU using CUDA acceleration

models:
  llama-2-7b:
    model_type: chat_or_base_to_be_confirmed
    q4: models/llama-2-7b/Q4_K_M.gguf
    q8: models/llama-2-7b/llama-2-7b.Q8_0.gguf
  qwen2.5-7b:
    model_type: instruct
    q4: models/qwen2.5-7b/Qwen2.5-7B-Instruct-Q4_K_M.gguf
    q8: models/qwen2.5-7b/Qwen2.5-7B-Instruct-Q8_0.gguf

selected_models:
  - llama-2-7b
  - qwen2.5-7b

selected_quantizations:
  - q4
  - q8

llama_cpp_params:
  n_ctx: 4096
  max_tokens: 1024
  temperature: 0.0
  top_p: 1.0
  seed: 42
  echo: false
  stop: null

generation_mode:
  name: deterministic_energy
  vary_seed_by_repetition: false

context_policy:
  on_context_overflow: skip
  allow_prompt_truncation: false

codecarbon:
  project_name: green_ai_llm_quality_energy
  # country_iso_code: no configurado — CodeCarbon detecta
  # automaticamente la intensidad de carbono por geolocalizacion IP
  # El valor detectado se guarda en el CSV para trazabilidad
  # Referencia: Courty et al. 2023 arXiv:2002.05651
  save_to_file: false
  log_level: error
  measure_power_secs: 1
  include_embodied_emissions_in_sci: false

judge:
  enabled: true
  provider: anthropic
  claude_model: claude-model-configurable
  anthropic_api_key_env: ANTHROPIC_API_KEY
  measure_judge_energy: false
  max_retries: 3
  sleep_between_requests_seconds: 1
  score_name: Claude-based MT-Bench-style quality score
  mode: claude_multidimensional
  also_run_mtbench_single_score_prompt: true
  use_reference_when_available_for:
    - math
    - reasoning
    - coding
    - stem

analysis:
  remove_failed_runs: true
  min_successful_repetitions_per_prompt: 10
  primary_energy_metric: baseline_corrected_energy
  statistical_tests_enabled: true
  bootstrap_iterations: 10000
  alpha: 0.05

plots:
  enabled: true
  figure_format: png
  dpi: 300
  error_bar: ci95
  confidence_level: 0.95
  top_n_ranking: 20
  use_energy_metric: baseline_corrected_energy
