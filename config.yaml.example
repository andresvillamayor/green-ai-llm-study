# GREEN-IA — Plantilla de configuracion
# Copiar como config.yaml y editar los valores.
#
#   cp config.yaml.example config.yaml
#
# config.yaml es especifico de la maquina y no se commitea.

# ─── Perfil de hardware ────────────────────────────────────────────────────────
# Opciones: mac_m4 | windows_nvidia
hardware_profile: mac_m4

# ─── Dispositivo de inferencia ────────────────────────────────────────────────
# Opciones: cpu | gpu
#
# Reglas n_gpu_layers:
#   mac_m4         + cpu -> n_gpu_layers = 0
#   mac_m4         + gpu -> n_gpu_layers = -1  (backend = Metal)
#   windows_nvidia + cpu -> n_gpu_layers = 0
#   windows_nvidia + gpu -> n_gpu_layers = -1  (backend = CUDA)
execution_device: gpu

# ─── Control de ejecucion en tiempo real ──────────────────────────────────────
runtime_control:

  # ── Power state ──────────────────────────────────────────────────────────────
  # prevent_sleep: evita que el SO entre en estado de bajo consumo durante el
  #   experimento.
  #   macOS: si prevent_sleep = true Y use_caffeinate_on_macos = true Y
  #          hardware_profile = mac_m4, se activa caffeinate -dimsu.
  #   Windows: no se usa caffeinate. Configurar manualmente:
  #     - Conectar a CA (no bateria).
  #     - Plan de energia: Alto Rendimiento o Mejor Rendimiento.
  #     - Deshabilitar suspension automatica.
  #     Ver README.md -> Recomendaciones de potencia (Windows NVIDIA).
  prevent_sleep: true
  use_caffeinate_on_macos: true

  # ── Cooldowns ─────────────────────────────────────────────────────────────────
  # Pausas en segundos ejecutadas FUERA del tracker CodeCarbon (P3).
  # No se registran como energia de inferencia.
  #
  # cooldown_seconds_between_runs: pausa entre configuraciones de parametros
  #   (despues de liberar el modelo con gc.collect). Permite que la GPU/CPU
  #   baje temperatura antes del siguiente modelo.
  # cooldown_seconds_between_model_configs: pausa adicional al cambiar de archivo
  #   GGUF distinto. Mayor que between_runs porque es una transicion mas costosa.
  cooldown_seconds_between_runs: 10
  cooldown_seconds_between_model_configs: 60

  # ── Warmup ────────────────────────────────────────────────────────────────────
  # Inferencias de calentamiento ejecutadas ANTES de las mediciones oficiales
  # para estabilizar las caches del kernel de la GPU/CPU y el JIT de llama.cpp.
  # Estas inferencias NO se incluyen en los resultados oficiales.
  #
  # warmup_runs_per_configuration: numero de inferencias de warmup por config.
  # discard_warmup_runs: siempre debe ser true. Los resultados de warmup no se
  #   guardan en el CSV para garantizar que las mediciones reflejen estado estable.
  warmup_runs_per_configuration: 1
  discard_warmup_runs: true

  # ── Pausas de estabilizacion termica ─────────────────────────────────────────
  # pause_before_start_seconds: pausa unica al inicio del experimento, antes de
  #   cargar cualquier modelo. Permite que el sistema llegue a temperatura estable.
  # pause_after_model_load_seconds: pausa despues de cargar cada modelo en memoria,
  #   antes del warmup. Da tiempo para que la GPU/CPU estabilice su frecuencia.
  # pause_after_experiment_seconds: pausa despues de completar todas las
  #   mediciones, antes de guardar el CSV. Permite que el sistema se estabilice
  #   antes de volver a uso interactivo.
  pause_before_start_seconds: 30
  pause_after_model_load_seconds: 20
  pause_after_experiment_seconds: 10

# ─── Calibracion de baseline idle ────────────────────────────────────────────
# Mide la potencia del sistema en reposo antes de cada configuracion experimental
# (modelo + cuantizacion + dispositivo). Se usa para calcular la energia neta de
# inferencia restando el consumo de fondo.
#
# Referencia metodologica:
#   Bannour et al. (2021). EMNLP 2021. "idle subtraction".
#   Anthony et al. (2020). ICML Workshop. Duracion minima recomendada: 30 s.
#
# enabled: si false, usa una unica medicion de 30 s (comportamiento anterior).
# baseline_idle_seconds: duracion de cada medicion de reposo (en segundos).
#   60 s reduce el ruido de estimacion TDP de CodeCarbon.
# baseline_repetitions: numero de repeticiones por configuracion. El promedio
#   de las potencias se usa para la correccion de cada inferencia.
# subtract_idle_baseline: si true, el CSV incluye los campos
#   baseline_corrected_energy_joules y baseline_corrected_energy_wh.
# save_baseline_runs: si true, cada medicion de baseline se guarda en
#   results/raw/baseline_results.csv para trazabilidad.
energy_calibration:
  enabled: true
  baseline_idle_seconds: 60
  baseline_repetitions: 3
  subtract_idle_baseline: true
  save_baseline_runs: true

# ─── Metrica primaria de analisis ─────────────────────────────────────────────
# Controla que metrica usan graficas y tablas en analizar_resultados.py.
#
# Valores validos:
#   measured_energy           — energia bruta medida por CodeCarbon (sin correccion)
#   baseline_corrected_energy — energia neta = medida − potencia_idle × latencia
#
# El CSV siempre incluye ambas metricas. Este campo solo controla cual se usa
# como metrica primaria en las figuras y el analisis estadistico.
# Recomendacion: baseline_corrected_energy para comparaciones entre configuraciones.
analysis:
  primary_energy_metric: baseline_corrected_energy

# ─── Parametros de llama.cpp ──────────────────────────────────────────────────
# n_ctx: ventana de contexto en tokens. Para MT-Bench turno 2 (T1Q + T1A + T2Q)
#   se necesitan al menos ~2 000 tokens. 4096 es seguro para todas las categorias.
#   1024 es insuficiente para multi-turno — usar 4096 o superior.
# max_tokens: tokens maximos de salida por inferencia.
#   1024 permite respuestas completas en MT-Bench sin truncamiento excesivo.
# temperature = 0.0: generacion greedy (sin aleatoriedad). Maximiza reproducibilidad.
#   Ver generation_mode.name = deterministic_energy.
# top_p = 1.0: sin nucleus sampling. Consistente con temperature = 0.0.
# seed = 42: semilla fija para el muestreo de llama.cpp.
# echo: false → el prompt NO se incluye en los tokens de salida (solo completion).
#   Debe ser false para que tokens_output y energia reflejen solo la generacion.
# stop: null → sin tokens de parada adicionales (usa los del modelo).
# n_batch y n_threads se obtienen del hardware_profile (propiedades del perfil).
# n_gpu_layers se controla por execution_device (arriba).
llama_cpp_params:
  n_ctx: 4096
  max_tokens: 1024
  temperature: 0.0
  top_p: 1.0
  seed: 42
  echo: false
  stop: null

# ─── Politica de overflow de contexto ────────────────────────────────────────
# Controla el comportamiento cuando el prompt estimado + max_tokens > n_ctx.
# llama.cpp trunca el prompt silenciosamente si se permite. Para experimentos
# de energia reproducibles, el truncamiento silencioso introduce sesgo porque
# el modelo recibe un prompt distinto al planificado.
#
# on_context_overflow:
#   skip  — saltar la inferencia; guardar status = "context_overflow" en el CSV.
#   warn  — ejecutar con advertencia (llama.cpp truncara el prompt).
# allow_prompt_truncation:
#   false — rechazar la inferencia si el prompt seria truncado (recomendado).
#   true  — permitir que llama.cpp trunque el prompt silenciosamente.
context_policy:
  on_context_overflow: skip
  allow_prompt_truncation: false

# ─── Modo de generacion ───────────────────────────────────────────────────────
# name: etiqueta del modo, guardada en exp_config y reporte de entorno.
#
# Modo principal (comparacion energetica):
#   deterministic_energy — temperature = 0.0 fijo, semilla fija.
#   Las 15 repeticiones miden ESTABILIDAD de energia y latencia,
#   NO diversidad semantica (la salida es identica en cada rep).
#
# Modo secundario opcional (variabilidad de calidad):
#   stochastic_quality_variability — temperature = 0.7, vary_seed_by_repetition = true.
#   Activa generacion estocastica para estudiar variabilidad de calidad entre reps.
#   NO usar para la comparacion energetica principal.
#   Para activar, reemplazar el bloque por:
#     generation_mode:
#       name: stochastic_quality_variability
#       temperature: 0.7
#       vary_seed_by_repetition: true
#
# vary_seed_by_repetition: si true, seed += (rep - 1) para cada repeticion.
#   Con temperature = 0.0 no tiene efecto practico (salida ya es determinista).
generation_mode:
  name: deterministic_energy
  vary_seed_by_repetition: false
